# Variables de entorno de project-cminds (www.cminds.co).
#
# Copia este archivo a .env.local y rellena solo lo que necesites:
#   cp .env.example .env.local
# .env.local está en .gitignore: nunca subas valores reales al repositorio.
# En Vercel se configuran en Project → Settings → Environment Variables.
#
# El sitio compila y corre en local sin ninguna variable: las páginas públicas
# funcionan, y las rutas que dependen de una variable fallan con un error claro.
#
# Las variables NEXT_PUBLIC_* se incrustan en el JavaScript al compilar: son
# públicas (nunca pongas un secreto en ellas) y cambiarlas exige un nuevo deploy.

# ---------------------------------------------------------------------------
# Sitio

# URL canónica para metadatos, sitemap y JSON-LD. Sin barra final.
# Si falta o está vacía, se usa VERCEL_PROJECT_PRODUCTION_URL (la pone Vercel) y luego https://www.cminds.co.
# En local normalmente no hace falta.
# NEXT_PUBLIC_SITE_URL=https://www.cminds.co

# ---------------------------------------------------------------------------
# Medios en Cloudflare R2 (ver docs/r2-assets.md)

# URL pública del bucket, sin barra final. Ejemplos:
#   https://assets.naturatech.org          (dominio propio, recomendado en producción)
#   https://pub-<hash>.r2.dev              (solo pruebas: r2.dev tiene límite de tráfico)
# Vacía = los medios se sirven desde /public como hasta ahora.
# Los objetos conservan la ruta que tienen en /public:
#   /platforms/x/y.jpg  →  ${NEXT_PUBLIC_ASSETS_URL}/platforms/x/y.jpg
NEXT_PUBLIC_ASSETS_URL=

# Videos de portada de las iniciativas (URL completa, normalmente en R2).
# Vacías = la portada se muestra sin video.
NEXT_PUBLIC_T4N_HERO_VIDEO_URL=
NEXT_PUBLIC_NTL_HERO_VIDEO_URL=
NEXT_PUBLIC_VO_HERO_VIDEO_URL=

# Credenciales de R2 SOLO para el script de subida (scripts/r2-upload.mjs).
# No las necesita el sitio ni Vercel: ponlas solo en tu .env.local y solo si
# el dueño del proyecto te autorizó a escribir en el bucket.
# Se obtienen en Cloudflare → R2 → Manage R2 API Tokens (permiso "Object Read & Write"
# limitado a este bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Opcional. Por defecto: public, max-age=31536000, immutable (los archivos no cambian de nombre
# sin cambiar de contenido; si reemplazas un archivo con el mismo nombre, súbelo con otro nombre
# o baja este valor, p. ej. public, max-age=3600).
R2_CACHE_CONTROL=

# ---------------------------------------------------------------------------
# Backend (secretos de servidor: nunca con prefijo NEXT_PUBLIC_)

# Postgres para Prisma y /api/bioscanner-launch.
DATABASE_URL=

# Clave compartida de /api/reports, /api/download y /reportes/[id].
REPORTES_API_KEY=

# Clave de /api/bioscanner-launch.
BIOSCANNER_API_KEY=

# Rate limiting (5 escrituras/min por IP) con Upstash Redis. Sin ellas no hay límite (normal en local).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
